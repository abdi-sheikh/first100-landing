---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import { withBase } from '../utils/withBase';
import { FAQ } from '../data/faq';

const contactEmail = 'hello@first100.app';

const help = [
  {
    question: 'How do I get my purchase back on a new phone or iPad?',
    answer: 'Open the menu, tap "More for grown-ups", answer the quick sum, then tap Restore purchases. Use the same Apple Account you bought with.',
  },
  {
    question: 'How do I change the language?',
    answer: 'Open the menu and tap the pencil next to the language name at the top.',
  },
  {
    question: 'How do I change the family in the pictures?',
    answer: 'Open the menu, tap "More for grown-ups", answer the quick sum, then tap Family pictures.',
  },
  {
    question: 'The words are silent.',
    answer: 'Check the volume buttons on the side of the device. First100 plays even when the ring/silent switch is on silent.',
  },
  {
    question: 'Can I ask for a language?',
    answer: 'Yes. Tell us on the Request a Language page; we use requests to decide what comes next.',
  },
];
---

<BaseLayout title="Support" description="Help with First100: restoring purchases, changing the language or the family pictures, and answers to common questions.">
  <Header slot="header" currentPath="/support" />

  <section class="section support">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Support</p>
        <h1 class="section__title">How can we help?</h1>
        <p class="section__lede">
          Quick answers below. If yours isn't here, email <a href={`mailto:${contactEmail}`}>{contactEmail}</a> and we'll reply.
        </p>
      </div>
      <Faq items={help} />
    </div>
  </section>

  <section class="section" aria-labelledby="about-title">
    <div class="container">
      <div class="section__head">
        <h2 id="about-title" class="section__title">About First100</h2>
      </div>
      <Faq items={FAQ} />
      <p class="links">
        <a href={withBase('/request-language')}>Request a language</a>
        <a href={withBase('/privacy')}>Privacy</a>
        <a href={withBase('/terms')}>Terms</a>
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .support {
    background: linear-gradient(180deg, var(--cat-body), var(--color-bg) 60%);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-10);
    font-weight: var(--font-weight-bold);
  }
</style>
