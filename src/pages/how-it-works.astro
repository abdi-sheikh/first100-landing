---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import HearIt from '../components/HearIt.astro';
import { withBase } from '../utils/withBase';
import { PRICING } from '../data/apps';

const steps = [
  {
    title: 'Pick your language',
    body: 'Choose the language your family speaks, or the one your child is learning. Each word shows in that language, with its English underneath.',
    img: '/app/screens/ja_menu.webp',
    alt: 'The category menu in Japanese, with the language name and a pencil to change it',
  },
  {
    title: 'Tap a picture, hear the word',
    body: 'The word plays the moment a finger lands. Animals follow their name with their sound. Hold a card to save it.',
    img: '/app/screens/es.webp',
    alt: 'The Animals cards in Spanish: gato, perro, vaca, cabra, oveja, caballo',
  },
  {
    title: 'Move through the day',
    body: `${PRICING.categories} categories, from Animals and Food & Drink to Feelings and Actions. ${PRICING.freeCategories} are free; the rest unlock with one purchase.`,
    img: '/app/screens/hi_food.webp',
    alt: 'The Food & Drink cards in Hindi: milk, water, bread, biryani, banana, apple',
  },
];

const categories = [
  ['Animals', true], ['Colors', true], ['Family', true], ['Food & Drink', true],
  ['Body Parts', false], ['Numbers', false], ['Actions', false], ['Nature', false],
  ['Feelings', false], ['Yes, no and more', false], ['Around the house', false], ['Every day', false],
] as const;
---

<BaseLayout title="How it works" description="How First100 works: pick a language, tap a picture, hear the word. 100 first words in 12 categories.">
  <Header slot="header" currentPath="/how-it-works" />

  <section class="section how-hero">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">How it works</p>
        <h1 class="section__title">Three things to know.</h1>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <PhoneFrame label={s.alt}>
              <img src={withBase(s.img)} alt={s.alt} width="600" height="1300" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </PhoneFrame>
            <div class="step__copy">
              <p class="step__num">{i + 1}</p>
              <h2 class="step__title">{s.title}</h2>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--hear" aria-labelledby="hear-title">
    <div class="container">
      <div class="section__head">
        <h2 id="hear-title" class="section__title">Try it here.</h2>
        <p class="section__lede">The app's own pictures and voices. Pick a language and tap a card.</p>
      </div>
      <HearIt start="hi" />
    </div>
  </section>

  <section class="section" aria-labelledby="cats-title">
    <div class="container">
      <div class="section__head">
        <h2 id="cats-title" class="section__title">{PRICING.categories} categories, {PRICING.words} words</h2>
        <p class="section__lede">The first four are free in every language.</p>
      </div>
      <ul class="cats">
        {categories.map(([name, free]) => (
          <li class:list={['cat', { 'cat--free': free }]}>
            <span>{name}</span>
            {free && <span class="cat__free">Free</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .how-hero {
    background: linear-gradient(180deg, var(--cat-animals), var(--color-bg) 60%);
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-10);
  }

  .step {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-6);
  }

  .step :global(.phone) {
    width: min(100%, 260px);
  }

  .step__copy {
    display: grid;
    gap: var(--space-2);
    max-width: 22rem;
  }

  .step__num {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-surface);
    font-weight: var(--font-weight-bold);
  }

  .step__title {
    font-size: var(--font-size-xl);
  }

  .section--hear {
    background: var(--color-surface);
  }

  .cats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-3);
  }

  .cat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--color-border-soft);
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  .cat__free {
    font-size: var(--font-size-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
