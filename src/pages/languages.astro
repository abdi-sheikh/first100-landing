---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageTiers from '../components/LanguageTiers.astro';
import { withBase } from '../utils/withBase';
import { LANGUAGES, WORLD_LANGUAGES } from '../lib/catalog';
import { WORLD } from '../data/apps';
---

<BaseLayout
  title="Languages"
  description={`First100 in ${LANGUAGES.length} languages: ${WORLD_LANGUAGES.length} in ${WORLD.name}, and languages with their own app, starting with Somali.`}
>
  <Header slot="header" currentPath="/languages" />

  <section class="section languages">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Languages</p>
        <h1 class="section__title">Find your family's language.</h1>
        <p class="section__lede">
          {WORLD_LANGUAGES.length} languages live together in {WORLD.name}; a few have an app of their own.
          Every one has the same pictures and first words, made for toddlers.
        </p>
      </div>
      <LanguageTiers />
      <p class="request">Not here yet? <a href={withBase('/request-language')}>Ask for your language →</a></p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .languages {
    background: linear-gradient(180deg, var(--cat-animals), var(--color-bg) 40%);
  }

  .request {
    margin-top: var(--space-10);
  }

  .request a {
    font-weight: var(--font-weight-bold);
  }
</style>
