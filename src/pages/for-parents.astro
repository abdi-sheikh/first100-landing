---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Pricing from '../components/Pricing.astro';
import FamilyStrip from '../components/FamilyStrip.astro';
import Faq from '../components/Faq.astro';
import { withBase } from '../utils/withBase';
import { PRICING, WORLD } from '../data/apps';
import { FAQ } from '../data/faq';

const settings = [
  { title: 'Choose the language', body: 'Pick it on first open. Change it any time from the pencil next to its name in the menu.' },
  { title: 'Hear it in English too', body: 'The switch at the top plays each word in English instead, for grown-ups learning alongside.' },
  { title: 'Pick the family in the pictures', body: 'Keep the family that comes with your language, choose another, or see a different family each day.' },
  { title: 'Save favourite words', body: 'Hold a card to save it. Saved words collect under the star.' },
  { title: 'Grown-up things stay grown-up', body: 'Buying takes a press-and-hold. Settings, restore and links sit behind a quick sum a toddler can’t do.' },
  { title: 'Works offline', body: 'Every picture and word is inside the app. No internet, no account, no ads.' },
];
---

<BaseLayout title="For parents" description={`What First100 costs and how it works: ${PRICING.freeCategories} categories free in every language, one-time purchases, no ads, no subscriptions.`}>
  <Header slot="header" currentPath="/for-parents" />

  <section class="section parents-hero">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">For parents</p>
        <h1 class="section__title">Clear prices. No surprises.</h1>
        <p class="section__lede">
          {WORLD.name} is free to try in every language. If your child loves it, unlock the rest once, and that's it:
          no subscription, no ads, nothing to sign up for.
        </p>
      </div>
      <Pricing />
    </div>
  </section>

  <section class="section" aria-labelledby="settings-title">
    <div class="container">
      <div class="section__head">
        <h2 id="settings-title" class="section__title">Set it up your way</h2>
      </div>
      <ul class="settings">
        {settings.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--families" aria-labelledby="families-title">
    <div class="container">
      <div class="section__head">
        <h2 id="families-title" class="section__title">The seven families</h2>
        <p class="section__lede">The Family cards, and the children in Actions, Feelings and Body Parts, come in seven families.</p>
      </div>
      <FamilyStrip />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="section__head">
        <h2 id="faq-title" class="section__title">Questions parents ask</h2>
      </div>
      <Faq items={FAQ} />
      <p class="more">Something else? <a href={withBase('/support')}>Support</a> has the rest, and a way to reach us.</p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .parents-hero {
    background: linear-gradient(180deg, var(--cat-food), var(--color-bg) 90%);
  }

  .settings {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-8) var(--space-10);
  }

  .settings h3 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-2);
  }

  .section--families {
    background: var(--cat-family);
  }

  .section--families :global(.families__item) {
    background: var(--color-surface);
  }

  .more {
    margin-top: var(--space-8);
  }
</style>
