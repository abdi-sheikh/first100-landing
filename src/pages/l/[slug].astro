---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PhoneFrame from '../../components/PhoneFrame.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';
import HearIt from '../../components/HearIt.astro';
import Pricing from '../../components/Pricing.astro';
import Faq from '../../components/Faq.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { withBase } from '../../utils/withBase';
import { LANGUAGES, WORLD_LANGUAGES, scriptClass, type Language } from '../../lib/catalog';
import { APPS, PRICING, WORLD } from '../../data/apps';
import { FAQ } from '../../data/faq';
import appWords from '../../data/app-words.json';

export function getStaticPaths() {
  return LANGUAGES.map((language) => ({ params: { slug: language.slug }, props: { language } }));
}

interface Props {
  language: Language;
}

const { language } = Astro.props;
const { name, nativeName, code, app, status, appStore, appName } = language;
const script = scriptClass(code);
const words = (appWords.words as Record<string, { english: string; native: string; imageName: string | null; color: string | null; category: string }[]>)[code] ?? [];
const inWorld = app === 'world';
const hasApp = app !== 'standalone';
const appStoreId = app === 'standalone' ? null : APPS[app].appStoreId;

// The app's twelve categories, in the order the app shows them.
const CATEGORY_NAMES: Record<string, string> = {
  Animals: 'Animals', Colors: 'Colors', Family: 'Family', Food_Drink: 'Food & Drink', Body_Parts: 'Body Parts',
  Numbers: 'Numbers', Actions_Verbs: 'Actions', Nature_Outside: 'Nature', Feelings_Words: 'Feelings',
  Core_Responses: 'Yes, no and more', Objects_Home: 'Around the house', Utility_Daily: 'Every day',
};
const groups = Object.keys(CATEGORY_NAMES)
  .map((cat) => ({ name: CATEGORY_NAMES[cat], words: words.filter((w) => w.category === cat) }))
  .filter((g) => g.words.length);
const showEnglish = code !== 'en';

const screen = inWorld ? withBase(`/app/screens/${code}.webp`) : code === 'so' ? withBase('/screenshots/app-screen-1.png') : null;
// The shared answers describe First100 World; other apps get only the ones true for every app.
const faq = inWorld ? FAQ : FAQ.filter((q) => /Who is First100 for|need the internet|Android/.test(q.question));
const related = WORLD_LANGUAGES.filter((l) => l.slug !== language.slug);

const lede = inWorld
  ? `${name} is one of ${WORLD_LANGUAGES.length} languages in ${WORLD.name}: ${PRICING.words} first words in ${PRICING.categories} categories, each said in ${name}${showEnglish ? ' with its English beside it' : ''}.`
  : hasApp
    ? `${appName}: ${PRICING.words} first words in ${name}, in ${PRICING.categories} categories, for toddlers and the grown-ups beside them.`
    : `${name} is getting its own First100 app. Leave your email and we'll write once, when it's ready.`;
const title = `First words in ${name}`;
const description = inWorld
  ? `${PRICING.words} first words in ${name} for toddlers. Tap a picture, hear the word. Part of ${WORLD.name}. No ads, no subscriptions.`
  : `${PRICING.words} first words in ${name} for toddlers. Tap a picture, hear the word. No ads.`;
---

<BaseLayout title={title} description={description} appStoreId={appStoreId}>
  <Header slot="header" currentPath={`/l/${language.slug}`} />

  <section class="lhero">
    <div class="container lhero__grid">
      <div class="lhero__copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={withBase('/languages')}>Languages</a>
          <span aria-hidden="true">/</span>
          <span>{name}</span>
        </nav>
        <p class="eyebrow">{hasApp ? appName : 'Its own app, coming'}</p>
        <h1 class="lhero__title">First words in {name}</h1>
        {nativeName !== name && <p class:list={['lhero__native', script]} lang={code}>{nativeName}</p>}
        <p class="lhero__lede">{lede}</p>
        {hasApp ? (
          <AppStoreBadge href={appStore} appName={appName ?? name} size="large" notifyHref="#notify" cta={`language-${language.slug}`} />
        ) : (
          <a class="lhero__notify" href="#notify">Tell me when it's ready →</a>
        )}
        {inWorld && <p class="lhero__promise">No ads. No subscriptions. {PRICING.freeCategories} categories free.</p>}
      </div>
      {screen && (
        <div class="lhero__visual">
          <PhoneFrame label={`The ${name} app`}>
            <img src={screen} alt={`First100 in ${name}: the Animals cards`} width="600" height="1300" loading="eager" decoding="async" />
          </PhoneFrame>
        </div>
      )}
    </div>
  </section>

  {words.length > 0 && (
    <section class="section section--hear" aria-labelledby="hear-title">
      <div class="container">
        <div class="section__head">
          <p class="eyebrow">Try it here</p>
          <h2 id="hear-title" class="section__title">Hear it in {name}.</h2>
          <p class="section__lede">The app's own pictures and voice. Tap a card.</p>
        </div>
        <HearIt start={code} pick={false} />
      </div>
    </section>
  )}

  {groups.length > 0 && (
    <section class="section" aria-labelledby="words-title">
      <div class="container">
        <div class="section__head">
          <p class="eyebrow">All {words.length} words</p>
          <h2 id="words-title" class="section__title">The first {words.length} words in {name}</h2>
        </div>
        <div class="words">
          {groups.map((g) => (
            <section class="words__group">
              <h3 class="words__cat">{g.name}</h3>
              <ul class="words__list">
                {g.words.map((w) => (
                  <li>
                    <span class:list={['words__native', script]} lang={code}>{w.native}</span>
                    {showEnglish && <span class="words__english">{w.english}</span>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>
  )}

  {inWorld && (
    <section class="section section--pricing" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section__head">
          <h2 id="pricing-title" class="section__title">Try it free. Unlock once.</h2>
        </div>
        <Pricing />
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="section__head">
        <h2 id="faq-title" class="section__title">Questions parents ask</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  {status !== 'available' && (
    <section class="section section--notify" id="notify" aria-labelledby="notify-title">
      <div class="container notify">
        <NewsletterSignup source="launch" language={language.slug} title={`Hear ${name} first`} body={`One email when ${hasApp ? appName : `the ${name} app`} is on the App Store. Nothing else unless you ask.`} button="Tell me" />
      </div>
    </section>
  )}

  <section class="section section--related" aria-labelledby="related-title">
    <div class="container">
      <h2 id="related-title" class="related__title">Also in {WORLD.name}</h2>
      <ul class="related">
        {related.map((l) => (
          <li><a href={withBase(`/l/${l.slug}`)}><span class={scriptClass(l.code)}>{l.nativeName}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .lhero {
    padding-block: clamp(24px, 4vw, 48px) clamp(56px, 8vw, 104px);
    background: linear-gradient(180deg, var(--cat-animals), var(--color-bg) 85%);
  }

  .lhero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .lhero__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .crumbs {
    display: flex;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-soft);
    margin-bottom: var(--space-4);
  }

  .crumbs a {
    color: var(--color-text-muted);
  }

  .lhero__title {
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    overflow-wrap: normal;
  }

  .lhero__native {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    line-height: 1.3;
  }

  .lhero__native.script-urdu {
    line-height: 2;
  }

  .lhero__lede {
    font-size: var(--font-size-lg);
    max-width: 36rem;
    margin-bottom: var(--space-2);
  }

  .lhero__promise {
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .lhero__notify {
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-lg);
  }

  .lhero__visual {
    display: grid;
    justify-items: center;
  }

  .section--hear {
    background: var(--color-surface);
  }

  .words {
    columns: 3 16rem;
    column-gap: var(--space-10);
  }

  .words__group {
    break-inside: avoid;
    margin-bottom: var(--space-8);
  }

  .words__cat {
    font-size: var(--font-size-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .words__list {
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .words__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-3);
  }

  .words__native {
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    font-size: var(--font-size-md);
  }

  .words__native.script-urdu {
    line-height: 1.9;
  }

  .words__english {
    color: var(--color-text-soft);
    font-size: var(--font-size-sm);
  }

  .section--pricing {
    background: var(--cat-food);
  }

  .section--notify {
    background: var(--color-accent-soft);
  }

  .notify :global(.newsletter) {
    width: min(100%, 36rem);
  }

  .related__title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-5);
  }

  .related {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .related a {
    display: inline-block;
    padding: 8px 14px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--color-border);
    color: var(--color-text);
  }

  .related .script-urdu {
    line-height: 1.4;
  }

  @media (max-width: 860px) {
    .lhero__grid {
      grid-template-columns: 1fr;
    }

    .lhero :global(.phone) {
      width: min(100%, 260px);
    }
  }
</style>
