---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import HearIt from '../components/HearIt.astro';
import FamilyStrip from '../components/FamilyStrip.astro';
import Pricing from '../components/Pricing.astro';
import LanguageTiers from '../components/LanguageTiers.astro';
import Faq from '../components/Faq.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { withBase } from '../utils/withBase';
import { WORLD, SOMALI, PRICING, appStoreUrl } from '../data/apps';
import { WORLD_LANGUAGES } from '../lib/catalog';
import { FAQ } from '../data/faq';

const worldStore = appStoreUrl(WORLD);
const somaliStore = appStoreUrl(SOMALI);
const count = WORLD_LANGUAGES.length;
const video = withBase('/app/video/cow-in-17-languages.mp4');
const poster = withBase('/app/video/cow-poster.webp');
---

<BaseLayout
  title="First100"
  description={`First words for toddlers in ${count} languages. Tap a picture, hear the word in your family's language. No ads, no subscriptions.`}
  appStoreId={WORLD.appStoreId}
>
  <Header slot="header" currentPath="/" />

  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">{WORLD.name} · {count} languages</p>
        <h1 class="hero__title">First words in your family's language.</h1>
        <p class="hero__lede">
          A toddler touches a picture and hears the word, in Spanish, Hindi, Urdu, Mandarin and {count - 4} more.
          {PRICING.words} words, {PRICING.categories} categories, made for a small hand.
        </p>
        <div class="hero__get" id="get">
          <AppStoreBadge href={worldStore} appName={WORLD.name} size="large" notifyHref="#notify" cta="hero" />
        </div>
        <p class="hero__promise">No ads. No subscriptions. No accounts.</p>
        {somaliStore && (
          <p class="hero__somali">
            Somali family? <a href={withBase('/l/somali')}>{SOMALI.name} is on the App Store now →</a>
          </p>
        )}
      </div>

      <div class="hero__visual">
        <PhoneFrame label="The First100 app: one cow, said in 17 languages">
          <video class="hero__video" src={video} poster={poster} autoplay muted loop playsinline preload="metadata" aria-label="A cow card in the app, with the word said in 17 languages"></video>
        </PhoneFrame>
        <button type="button" class="hero__sound" aria-pressed="false">Play with sound</button>
      </div>
    </div>
  </section>

  <section class="section section--hear" aria-labelledby="hear-title">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Try it here</p>
        <h2 id="hear-title" class="section__title">Tap a picture. Hear the word.</h2>
        <p class="section__lede">The same pictures and voices as the app. Pick a language, then tap the cow.</p>
      </div>
      <HearIt start="es" />
    </div>
  </section>

  <section class="section section--hand" aria-labelledby="hand-title">
    <div class="container split">
      <div class="split__visual">
        <PhoneFrame label="The Family category in Spanish" tilt={-2}>
          <img src={withBase('/app/screens/es_family.webp')} alt="The Family cards in Spanish: mamá, papá, bebé, hermano, hermana, abuela" width="600" height="1300" loading="lazy" decoding="async" />
        </PhoneFrame>
      </div>
      <div class="split__copy">
        <p class="eyebrow">Made for a toddler's hand</p>
        <h2 id="hand-title" class="section__title">Nothing to read. Nothing to break.</h2>
        <ul class="points">
          <li><strong>The word plays the moment a finger lands.</strong> Small children press and hold; they still hear it.</li>
          <li><strong>Grown-up things need a grown-up.</strong> Buying takes a deliberate press-and-hold, and settings sit behind a quick sum.</li>
          <li><strong>Hold a card to save it.</strong> A child's favourite words collect under the star.</li>
          <li><strong>Hear it in English too.</strong> One switch plays each word's English, for families learning together.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--families" aria-labelledby="families-title">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Families like yours</p>
        <h2 id="families-title" class="section__title">Seven families, drawn with care.</h2>
        <p class="section__lede">
          Parents, grandparents, brothers and sisters, and the children in Actions and Feelings, in a range of skin
          tones and everyday clothes. Each language starts with one family; in the grown-ups area you can choose another,
          or meet a different family every day.
        </p>
      </div>
      <FamilyStrip />
    </div>
  </section>

  <section class="section section--trust" aria-labelledby="trust-title">
    <div class="container trust">
      <div>
        <p class="eyebrow">Words you can trust</p>
        <h2 id="trust-title" class="section__title">Checked, word by word.</h2>
      </div>
      <p class="trust__copy">
        Every language gets the same {PRICING.words} first words: the ones young children learn first, like
        <em>mama</em>, <em>milk</em>, <em>dog</em> and <em>ball</em>. The words are checked against published dictionaries,
        language by language, and every recording goes through a listening test, so the word your child hears is the word it should be.
      </p>
    </div>
  </section>

  <section class="section section--pricing" aria-labelledby="pricing-title">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-title" class="section__title">Try it free. Unlock once.</h2>
        <p class="section__lede">
          {PRICING.freeCategoryNames.join(', ').replace(/, ([^,]*)$/, ' and $1')} are free in every language. Keep the rest
          of a language, or all of them, with one purchase.
        </p>
      </div>
      <Pricing />
    </div>
  </section>

  <section class="section section--languages" aria-labelledby="languages-title">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Languages</p>
        <h2 id="languages-title" class="section__title">{count} languages in one app.</h2>
      </div>
      <LanguageTiers />
      <p class="request">Is your family's language missing? <a href={withBase('/request-language')}>Tell us which one →</a></p>
    </div>
  </section>

  <section class="section section--faq" aria-labelledby="faq-title">
    <div class="container">
      <div class="section__head">
        <h2 id="faq-title" class="section__title">Questions parents ask</h2>
      </div>
      <Faq items={FAQ} />
    </div>
  </section>

  <section class="section section--notify" id="notify" aria-labelledby="notify-title">
    <div class="container notify">
      <h2 id="notify-title" class="section__title">{worldStore ? 'Get First100 today.' : `${WORLD.name} is almost here.`}</h2>
      {worldStore ? (
        <AppStoreBadge href={worldStore} appName={WORLD.name} size="large" cta="footer" />
      ) : (
        <NewsletterSignup source="launch" title="Hear it first" body="One email when the app is on the App Store. Nothing else unless you ask." button="Tell me" />
      )}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const video = document.querySelector<HTMLVideoElement>('.hero__video');
  const button = document.querySelector<HTMLButtonElement>('.hero__sound');
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) video?.pause();
  button?.addEventListener('click', () => {
    if (!video) return;
    const on = video.muted;
    video.muted = !on;
    if (on) { video.currentTime = 0; video.play().catch(() => {}); }
    button.setAttribute('aria-pressed', String(on));
    button.textContent = on ? 'Mute' : 'Play with sound';
  });
</script>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 96px) clamp(56px, 8vw, 112px);
    background: linear-gradient(180deg, var(--cat-animals), var(--color-bg) 85%);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .hero__title {
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 15ch;
    overflow-wrap: normal;
  }

  .hero__lede {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    max-width: 34rem;
  }

  .hero__get {
    margin-top: var(--space-2);
  }

  .hero__promise {
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .hero__somali {
    font-size: var(--font-size-sm);
  }

  .hero__somali a {
    font-weight: var(--font-weight-bold);
  }

  .hero__visual {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }

  /* The social cut keeps its bottom quarter clear for TikTok's buttons; inside a phone that
     reads as empty, so zoom in slightly from the top. */
  .hero__video {
    background: var(--cat-animals);
    transform: scale(1.2);
    transform-origin: 50% 6%;
  }

  .hero__sound {
    border: 0;
    border-radius: var(--radius-full);
    padding: 10px 18px;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
    cursor: pointer;
  }

  .hero__sound[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .section--hear {
    background: var(--color-surface);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }

  .split__visual {
    display: grid;
    justify-items: center;
  }

  .split__copy {
    display: grid;
    gap: var(--space-5);
  }

  .points {
    list-style: none;
    display: grid;
    gap: var(--space-5);
    max-width: 36rem;
  }

  .points li {
    color: var(--color-text-muted);
    padding-left: var(--space-5);
    border-left: 3px solid var(--chip-family);
  }

  .points strong {
    display: block;
    color: var(--color-text);
  }

  .section--families {
    background: var(--cat-family);
  }

  .section--families :global(.families__item) {
    background: var(--color-surface);
  }

  .trust {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-8) clamp(32px, 6vw, 96px);
    align-items: end;
  }

  .trust__copy {
    font-size: var(--font-size-lg);
    color: var(--color-text);
    max-width: 38rem;
  }

  .section--pricing {
    background: var(--cat-food);
  }

  .request {
    margin-top: var(--space-8);
  }

  .request a {
    font-weight: var(--font-weight-bold);
  }

  .section--notify {
    background: var(--color-accent-soft);
  }

  .notify {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }

  .notify :global(.newsletter) {
    width: min(100%, 36rem);
  }

  @media (max-width: 860px) {
    .hero__grid,
    .split,
    .trust {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      order: 2;
    }

    .hero :global(.phone) {
      width: min(100%, 280px);
    }
  }
</style>
