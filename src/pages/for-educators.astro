---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/withBase';
import { WORLD_LANGUAGES } from '../lib/catalog';
import { WORLD } from '../data/apps';

const contactEmail = 'hello@first100.app';

const fits = [
  { title: 'A classroom with many home languages', body: `${WORLD_LANGUAGES.length} languages in one app, so each child can hear their own words, and their classmates can hear them too.` },
  { title: 'Speech and language sessions', body: 'A full-screen view for one card at a time, fast switching between categories, and no purchase prompts in the middle of a session.' },
  { title: 'Libraries and family programs', body: 'No accounts and no ads, and it works offline, so a shared tablet is ready for the next family.' },
];
---

<BaseLayout title="For educators" description={`First100 in classrooms, clinics and family programs: ${WORLD_LANGUAGES.length} languages in one app, no accounts, no ads, works offline.`}>
  <Header slot="header" currentPath="/for-educators" />

  <section class="section edu">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">For educators and clinicians</p>
        <h1 class="section__title">One app for the languages in your room.</h1>
        <p class="section__lede">
          {WORLD.name} was built for toddlers and the adults beside them. It fits a few places beyond home especially well.
        </p>
      </div>
      <ul class="fits">
        {fits.map((f) => (
          <li>
            <h2>{f.title}</h2>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--contact" aria-labelledby="contact-title">
    <div class="container contact">
      <h2 id="contact-title" class="section__title">Using First100 with a group?</h2>
      <p class="section__lede">
        Tell us about your program: how many children, which languages, and what you're hoping for. We read every message.
      </p>
      <div class="contact__actions">
        <a class="contact__primary" href={`mailto:${contactEmail}?subject=First100%20for%20our%20program`}>Email us</a>
        <a href={withBase('/languages')}>See the languages →</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .edu {
    background: linear-gradient(180deg, var(--cat-actions), var(--color-bg) 70%);
  }

  .fits {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-8) var(--space-10);
  }

  .fits h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-2);
  }

  .section--contact {
    background: var(--color-accent-soft);
  }

  .contact {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    font-weight: var(--font-weight-bold);
  }

  .contact__primary {
    padding: 12px 22px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .contact__primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-surface);
  }
</style>
