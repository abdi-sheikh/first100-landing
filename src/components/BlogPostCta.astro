---
import { languageBySlug } from '../lib/catalog';
import { withBase } from '../utils/withBase';

interface Props { language?: string | null; }
const { language } = Astro.props;

const lang = languageBySlug(language);
const ctaHref = lang ? withBase(`/l/${lang.slug}`) : withBase('/languages');
const ctaTitle = lang ? `First words in ${lang.name}` : 'First words in your family\'s language';
const where = lang?.appName ? ` It's in ${lang.appName}` : '';
const when = lang?.status === 'available' ? ', on the App Store now.' : lang?.appName ? ', coming soon to the App Store.' : '';
const ctaBody = lang
  ? `Tap a picture, hear the word in ${lang.name}. No ads, no subscriptions.${where}${when}`
  : 'Tap a picture, hear the word, in 17 languages. No ads, no subscriptions.';
---
<aside class="blog-cta">
  <div class="blog-cta__inner">
    <h3 class="blog-cta__title">{ctaTitle}</h3>
    <p class="blog-cta__body">{ctaBody}</p>
    <a
      class="blog-cta__link"
      href={ctaHref}
      data-cta="blog-post"
      data-cta-language={lang ? lang.slug : ''}
    >
      {lang ? `See First100 in ${lang.name} →` : 'Find your language →'}
    </a>
  </div>
</aside>

<script>
  // Funnel event: blog post -> app CTA click. Read in PostHog alongside
  // pageview and (downstream) the app-store click on the language page.
  document.querySelectorAll('a[data-cta="blog-post"]').forEach((el) => {
    el.addEventListener('click', () => {
      if (window.posthog) {
        window.posthog.capture('cta_click', {
          cta: 'blog-post',
          language: el.getAttribute('data-cta-language') || null,
          href: el.getAttribute('href'),
        });
      }
    });
  });
</script>

<style>
.blog-cta {
  margin: 3rem 0 2rem;
  padding: 2rem;
  background: linear-gradient(135deg, rgba(74, 124, 89, 0.08), rgba(74, 124, 89, 0.04));
  border: 1px solid rgba(74, 124, 89, 0.18);
  border-radius: 16px;
}
.blog-cta__title {
  margin: 0 0 0.5rem;
  font-size: 1.35rem;
  color: var(--color-text);
}
.blog-cta__body {
  margin: 0 0 1.25rem;
  font-size: 1rem;
  line-height: 1.5;
  color: var(--color-text-muted);
}
.blog-cta__link {
  display: inline-block;
  padding: 0.75rem 1.25rem;
  background: var(--color-accent);
  color: white;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 500;
  transition: transform 120ms ease, background 120ms ease;
}
.blog-cta__link:hover {
  transform: translateY(-1px);
  background: #3b6b49;
}
</style>
