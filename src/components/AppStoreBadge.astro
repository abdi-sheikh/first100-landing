---
// The one way the site sends people to the App Store: Apple's official badge when the app is
// live, and a plain "coming soon" label when it isn't (never a button that goes nowhere).
// Apple's logo appears only inside Apple's own badge artwork, as its guidelines require.
import { withBase } from '../utils/withBase';

interface Props {
  href: string | null;
  appName: string;
  size?: 'medium' | 'large';
  /** Where a "tell me when it's out" link should go while the app isn't live. */
  notifyHref?: string | null;
  cta?: string;
  language?: string | null;
  languageCode?: string | null;
}

const { href, appName, size = 'medium', notifyHref = null, cta = 'app-store', language = null, languageCode = null } = Astro.props;
const badge = withBase('/app/badge/app-store.svg');
---

{href ? (
  <a class:list={['badge', `badge--${size}`]} href={href} target="_blank" rel="noopener" data-cta={cta} data-app-store data-app-name={appName} data-language={language} data-language-code={languageCode} aria-label={`Download ${appName} on the App Store`}>
    <img src={badge} alt="" width="120" height="40" />
  </a>
) : (
  <div class:list={['soon', `soon--${size}`]}>
    <span class="soon__label">
      Coming soon to the App Store
    </span>
    {notifyHref && <a class="soon__notify" href={notifyHref}>Tell me when it's out</a>}
  </div>
)}

<script>
  type AnalyticsWindow = Window & {
    posthog?: { capture: (event: string, properties: Record<string, string | null>) => unknown };
  };

  // Astro runs this once per page, including when the page has several badges.
  // Keep the native link working when analytics is blocked or has not loaded.
  document.querySelectorAll<HTMLAnchorElement>('a[data-app-store]').forEach((link) => {
    const trackClick = () => {
      (window as AnalyticsWindow).posthog?.capture('app_store_click', {
        product: 'first100-web',
        app_name: link.dataset.appName ?? null,
        placement: link.dataset.cta ?? 'app-store',
        language: link.dataset.language ?? null,
        language_code: link.dataset.languageCode ?? null,
        page_path: window.location.pathname,
        app_store_url: link.href,
      });
    };

    link.addEventListener('click', trackClick);
    link.addEventListener('auxclick', (event) => {
      if (event.button === 1) trackClick();
    });
  });
</script>

<style>
  .badge {
    display: inline-block;
    border-radius: 10px;
    transition: transform var(--transition-fast);
  }

  .badge:active {
    transform: scale(0.97);
  }

  .badge img {
    height: 48px;
    width: auto;
  }

  .badge--large img {
    height: 56px;
  }

  .soon {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .soon__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 12px 18px;
    border-radius: 12px;
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-sm);
    line-height: 1.2;
  }

  .soon--large .soon__label {
    padding: 15px 22px;
    font-size: var(--font-size-base);
  }


  .soon__notify {
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
