---
import { withBase } from '../utils/withBase';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const basePrefix = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const normalizedCurrentPath =
  basePrefix && currentPath.startsWith(basePrefix)
    ? currentPath.slice(basePrefix.length) || '/'
    : currentPath;

const navItems = [
  { label: 'Languages', href: withBase('/languages'), active: normalizedCurrentPath.startsWith('/languages') || normalizedCurrentPath.startsWith('/l/') },
  { label: 'How it works', href: withBase('/how-it-works'), active: normalizedCurrentPath.startsWith('/how-it-works') },
  { label: 'For parents', href: withBase('/for-parents'), active: normalizedCurrentPath.startsWith('/for-parents') },
  { label: 'Blog', href: withBase('/blog'), active: normalizedCurrentPath.startsWith('/blog') },
  { label: 'Support', href: withBase('/support'), active: normalizedCurrentPath.startsWith('/support') }
];

const homePath = withBase('/');
const getPath = withBase('/#get');
const logoPath = withBase('/brand/logo-mark.png');
---

<header class="header">
  <div class="header__container container">
    <a href={homePath} class="header__logo" aria-label="First100 home">
      <img src={logoPath} alt="" width="36" height="36" loading="eager" decoding="async" class="header__logo-mark" />
      <span class="header__logo-text">First<span class="header__logo-num">100</span></span>
    </a>

    <nav class="header__nav" aria-label="Main">
      {navItems.map((item) => (
        <a href={item.href} class:list={["header__nav-link", { "header__nav-link--active": item.active }]} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <a href={getPath} class="header__cta">Get the app</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 251, 247, 0.96);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .header__container {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .header__logo-mark {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .header__logo-text {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .header__logo-num {
    color: var(--color-accent);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .header__nav::-webkit-scrollbar {
    display: none;
  }

  .header__nav-link {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    padding: 8px 12px;
    border-radius: var(--radius-full);
    white-space: nowrap;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .header__nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-accent-soft);
  }

  .header__nav-link--active {
    color: var(--color-accent);
    background-color: var(--color-accent-soft);
  }

  .header__cta {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    border-radius: var(--radius-full);
    padding: 10px 18px;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-surface);
    background: var(--color-accent);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .header__cta:hover {
    background: var(--color-accent-hover);
    color: var(--color-surface);
  }

  .header__cta:active {
    transform: scale(0.97);
  }

  @media (max-width: 900px) {
    .header__container {
      grid-template-columns: auto auto;
      grid-template-areas:
        'logo cta'
        'nav nav';
      justify-content: space-between;
      row-gap: 0;
      padding-block: var(--space-2) 0;
    }

    .header__logo { grid-area: logo; }
    .header__cta { grid-area: cta; }

    .header__nav {
      grid-area: nav;
      justify-content: flex-start;
      margin-inline: calc(var(--space-2) * -1);
      padding-block: var(--space-1) var(--space-2);
    }
  }
</style>
